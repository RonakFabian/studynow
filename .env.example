# Copy to .env and replace every CHANGE_ME (e.g. `openssl rand -hex 16`)
WEB_PORT=80

# MongoDB root (admin) account - used only to bootstrap the database
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=CHANGE_ME

# Least-privilege app account (readWrite on MONGO_APP_DB only)
MONGO_APP_DB=studyuk
MONGO_APP_USER=studyuk_app
MONGO_APP_PASSWORD=CHANGE_ME

# API
JWT_SECRET=CHANGE_ME
